{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
<div class="categorie-container">
    <div class="section-header">
        <h1>Nos categories</h1>
        <p>Trouve rapidement les produits qui correspondent a ton objectif.</p>
    </div>

    <div class="categorie-grid">
        {% for category in categories %}
            <div class="categorie-card">
                <h2>{{ category.name }}</h2>
                <p class="categorie-description">{{ category.description }}</p>
                <p class="categorie-count">{{ category.products_count }} produits</p>
                <div class="featured-products">
                    {% for product in category.featured_products %}
                        <span>{{ product }}</span>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<style>
    .categorie-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .section-header {
        text-align: center;
        margin-bottom: 35px;
    }

    .section-header h1 {
        margin: 0 0 10px;
        font-size: 2.2rem;
        color: #1f2937;
    }

    .section-header p {
        margin: 0;
        color: #6b7280;
    }

    .categorie-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .categorie-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    }

    .categorie-card h2 {
        margin: 0 0 10px;
        color: #111827;
    }

    .categorie-description {
        margin: 0 0 12px;
        color: #4b5563;
    }

    .categorie-count {
        margin: 0 0 12px;
        font-weight: 700;
        color: #0f172a;
    }

    .featured-products {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .featured-products span {
        font-size: 0.85rem;
        background: #f3f4f6;
        border-radius: 999px;
        padding: 5px 10px;
        color: #374151;
    }

    @media (max-width: 900px) {
        .categorie-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
{% endblock %}
