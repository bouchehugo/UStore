{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .auth-page {
            max-width: 520px;
            margin: 40px auto;
        }

        .auth-card {
            background: #ffffff;
            border-radius: 12px;
            padding: 30px 32px 26px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            border: 1px solid #f0f0f0;
        }

        .auth-title {
            font-size: 1.8rem;
            font-weight: 600;
            margin-bottom: 6px;
            color: #222;
        }

        .auth-subtitle {
            color: #777;
            font-size: 0.95rem;
            margin-bottom: 22px;
        }

        .auth-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px 16px;
        }

        .auth-form-group {
            margin-bottom: 16px;
        }

        .auth-form-group label {
            display: block;
            font-size: 0.9rem;
            font-weight: 500;
            margin-bottom: 6px;
            color: #444;
        }

        .auth-form-group input {
            width: 100%;
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid #d0d0d0;
            font-size: 0.95rem;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .auth-form-group input:focus {
            outline: none;
            border-color: #111827;
            box-shadow: 0 0 0 1px #1118271a;
        }

        .auth-terms {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin: 10px 0 18px;
            font-size: 0.85rem;
            color: #555;
        }

        .auth-terms input {
            margin-top: 2px;
        }

        .auth-terms a {
            color: #111827;
            text-decoration: none;
            font-weight: 500;
        }

        .auth-terms a:hover {
            text-decoration: underline;
        }

        .auth-submit-btn {
            width: 100%;
            border: none;
            background: #111827;
            color: #fff;
            font-size: 0.98rem;
            font-weight: 600;
            padding: 10px 0;
            border-radius: 999px;
            cursor: pointer;
            transition: background 0.15s ease, transform 0.1s ease;
        }

        .auth-submit-btn:hover {
            background: #020617;
            transform: translateY(-1px);
        }

        .auth-submit-btn:active {
            transform: translateY(0);
        }

        .auth-bottom-text {
            margin-top: 18px;
            font-size: 0.9rem;
            color: #666;
            text-align: center;
        }

        .auth-bottom-text a {
            color: #111827;
            text-decoration: none;
            font-weight: 500;
        }

        .auth-bottom-text a:hover {
            text-decoration: underline;
        }

        .flash-message {
            margin-bottom: 14px;
            padding: 10px 12px;
            border-radius: 8px;
            font-size: 0.86rem;
        }

        .flash-success {
            background-color: #ecfdf3;
            border: 1px solid #22c55e33;
            color: #166534;
        }

        .flash-error {
            background-color: #fef2f2;
            border: 1px solid #ef444433;
            color: #991b1b;
        }

        @media (max-width: 640px) {
            .auth-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="auth-page">
        <div class="auth-card">
            <h1 class="auth-title">Créer un compte</h1>
            <p class="auth-subtitle">Rejoignez UrbanFit et profitez de toutes nos offres.</p>

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-message flash-{{ type }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <form method="post" action="{{ path('inscription') }}">
                <div class="auth-grid">
                    <div class="auth-form-group">
                        <label for="firstname">Prénom</label>
                        <input type="text" id="firstname" name="firstname" placeholder="Votre prénom" required>
                    </div>

                    <div class="auth-form-group">
                        <label for="lastname">Nom</label>
                        <input type="text" id="lastname" name="lastname" placeholder="Votre nom" required>
                    </div>
                </div>

                <div class="auth-grid">
                    <div class="auth-form-group">
                        <label for="email">Adresse e-mail</label>
                        <input type="email" id="email" name="email" placeholder="vous@example.com" required>
                    </div>

                    <div class="auth-form-group">
                        <label for="tel">Téléphone</label>
                        <input type="text" id="tel" name="tel" placeholder="Votre numéro de téléphone">
                    </div>
                </div>

                <div class="auth-grid">
                    <div class="auth-form-group">
                        <label for="password">Mot de passe</label>
                        <input type="password" id="password" name="password" placeholder="Créez un mot de passe" required>
                    </div>

                    <div class="auth-form-group">
                        <label for="password_confirm">Confirmation</label>
                        <input type="password" id="password_confirm" name="password_confirm" placeholder="Confirmez le mot de passe" required>
                    </div>
                </div>

                <label class="auth-terms">
                    <input type="checkbox" name="accept_terms" required>
                    <span>
                        J'accepte les <a href="#">conditions générales</a> et la
                        <a href="#">politique de confidentialité</a>.
                    </span>
                </label>

                <button type="submit" class="auth-submit-btn">
                    Créer mon compte
                </button>
            </form>

            <div class="auth-bottom-text">
                Déjà un compte ?
                <a href="{{ path('connexion') }}">Se connecter</a>
            </div>
        </div>
    </div>
{% endblock %}
