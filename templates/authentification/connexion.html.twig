{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .auth-page {
            max-width: 450px;
            margin: 40px auto;
        }

        .auth-card {
            background: #ffffff;
            border-radius: 12px;
            padding: 30px 32px 26px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            border: 1px solid #f0f0f0;
        }

        .auth-title {
            font-size: 1.8rem;
            font-weight: 600;
            margin-bottom: 6px;
            color: #222;
        }

        .auth-subtitle {
            color: #777;
            font-size: 0.95rem;
            margin-bottom: 22px;
        }

        .auth-form-group {
            margin-bottom: 16px;
        }

        .auth-form-group label {
            display: block;
            font-size: 0.9rem;
            font-weight: 500;
            margin-bottom: 6px;
            color: #444;
        }

        .auth-form-group input {
            width: 100%;
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid #d0d0d0;
            font-size: 0.95rem;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .auth-form-group input:focus {
            outline: none;
            border-color: #111827;
            box-shadow: 0 0 0 1px #1118271a;
        }

        .auth-row-between {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
        }

        .auth-checkbox {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
            color: #555;
        }

        .auth-checkbox input {
            width: 16px;
            height: 16px;
        }

        .auth-forgot-link {
            font-size: 0.85rem;
            color: #111827;
            text-decoration: none;
            font-weight: 500;
        }

        .auth-forgot-link:hover {
            text-decoration: underline;
        }

        .auth-submit-btn {
            width: 100%;
            border: none;
            background: #111827;
            color: #fff;
            font-size: 0.98rem;
            font-weight: 600;
            padding: 10px 0;
            border-radius: 999px;
            cursor: pointer;
            transition: background 0.15s ease, transform 0.1s ease;
        }

        .auth-submit-btn:hover {
            background: #020617;
            transform: translateY(-1px);
        }

        .auth-submit-btn:active {
            transform: translateY(0);
        }

        .auth-bottom-text {
            margin-top: 18px;
            font-size: 0.9rem;
            color: #666;
            text-align: center;
        }

        .auth-bottom-text a {
            color: #111827;
            text-decoration: none;
            font-weight: 500;
        }

        .auth-bottom-text a:hover {
            text-decoration: underline;
        }
        
        .flash-message {
            margin-bottom: 14px;
            padding: 10px 12px;
            border-radius: 8px;
            font-size: 0.86rem;
        }

        .flash-success {
            background-color: #ecfdf3;
            border: 1px solid #22c55e33;
            color: #166534;
        }

        .flash-error {
            background-color: #fef2f2;
            border: 1px solid #ef444433;
            color: #991b1b;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="auth-page">
        <div class="auth-card">
            <h1 class="auth-title">Connexion</h1>
            <p class="auth-subtitle">Connectez-vous pour accéder à votre compte UrbanFit.</p>

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-message flash-{{ type }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <form method="post" action="{{ path('connexion') }}">
                <div class="auth-form-group">
                    <label for="email">Adresse e-mail</label>
                    <input type="email" id="email" name="email" placeholder="vous@example.com" required>
                </div>

                <div class="auth-form-group">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="password" placeholder="Votre mot de passe" required>
                </div>

                <div class="auth-row-between">
                    <label class="auth-checkbox">
                        <input type="checkbox" name="remember_me">
                        <span>Se souvenir de moi</span>
                    </label>

                    <a href="{{ path('mot_de_passe_oublie') }}" class="auth-forgot-link">
                        Mot de passe oublié ?
                    </a>
                </div>

                <button type="submit" class="auth-submit-btn">
                    Se connecter
                </button>
            </form>

            <div class="auth-bottom-text">
                Pas encore de compte ?
                <a href="{{ path('inscription') }}">Créer un compte</a>
            </div>
        </div>
    </div>
{% endblock %}
