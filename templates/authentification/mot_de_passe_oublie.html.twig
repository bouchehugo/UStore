{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .auth-page {
            max-width: 450px;
            margin: 40px auto;
        }

        .auth-card {
            background: #ffffff;
            border-radius: 12px;
            padding: 30px 32px 26px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            border: 1px solid #f0f0f0;
        }

        .auth-title {
            font-size: 1.8rem;
            font-weight: 600;
            margin-bottom: 6px;
            color: #222;
        }

        .auth-subtitle {
            color: #777;
            font-size: 0.95rem;
            margin-bottom: 22px;
        }

        .auth-form-group {
            margin-bottom: 18px;
        }

        .auth-form-group label {
            display: block;
            font-size: 0.9rem;
            font-weight: 500;
            margin-bottom: 6px;
            color: #444;
        }

        .auth-form-group input {
            width: 100%;
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid #d0d0d0;
            font-size: 0.95rem;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .auth-form-group input:focus {
            outline: none;
            border-color: #111827;
            box-shadow: 0 0 0 1px #1118271a;
        }

        .auth-info {
            font-size: 0.85rem;
            color: #666;
            margin-bottom: 18px;
        }

        .auth-submit-btn {
            width: 100%;
            border: none;
            background: #111827;
            color: #fff;
            font-size: 0.98rem;
            font-weight: 600;
            padding: 10px 0;
            border-radius: 999px;
            cursor: pointer;
            transition: background 0.15s ease, transform 0.1s ease;
        }

        .auth-submit-btn:hover {
            background: #020617;
            transform: translateY(-1px);
        }

        .auth-submit-btn:active {
            transform: translateY(0);
        }

        .auth-bottom-text {
            margin-top: 18px;
            font-size: 0.9rem;
            color: #666;
            text-align: center;
        }

        .auth-bottom-text a {
            color: #111827;
            text-decoration: none;
            font-weight: 500;
        }

        .auth-bottom-text a:hover {
            text-decoration: underline;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="auth-page">
        <div class="auth-card">
            <h1 class="auth-title">Mot de passe oublié</h1>
            <p class="auth-subtitle">Recevez un lien de réinitialisation par e-mail.</p>

            <p class="auth-info">
                Indiquez l'adresse e-mail associée à votre compte. Si un compte existe,
                vous recevrez un e-mail avec les instructions pour réinitialiser votre mot de passe.
            </p>

            <form method="post" action="#">
                <div class="auth-form-group">
                    <label for="email">Adresse e-mail</label>
                    <input type="email" id="email" name="email" placeholder="vous@example.com" required>
                </div>

                <button type="submit" class="auth-submit-btn">
                    Envoyer le lien
                </button>
            </form>

            <div class="auth-bottom-text">
                <a href="{{ path('connexion') }}">Retour à la connexion</a>
            </div>
        </div>
    </div>
{% endblock %}

